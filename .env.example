# Next.js Server & Client Configuration
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API Key (Recommended: Free via https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Alternative fallback if you prefer GPT)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Job Search APIs (Optional: system includes live Remotive, RemoteOK, Arbeitnow, Jobicy by default)
SERPAPI_API_KEY=your-serpapi-key
ADZUNA_APP_ID=your-adzuna-id
ADZUNA_APP_KEY=your-adzuna-key

# Email Dispatch (Free Primary Channel via Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=usman.shafiq@gmail.com
SMTP_PASS=your-gmail-app-password
SENDER_EMAIL=usman.shafiq@gmail.com
SENDER_NAME="Usman Shafiq"

# Local Auto-Scraping Settings
CRON_SCHEDULE="*/2 * * * *"
CRON_ENABLED=true
AUTO_TAILOR_THRESHOLD=75
